APP_NAME=Imgsli
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Bare hostname (no scheme) for the site, e.g. imgsli.example.com.
# docker-compose.yml uses it for the traefik router (Host(`${APP_HOST}`));
# in production set APP_URL to https://<APP_HOST>.
APP_HOST=
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=imgsli
DB_USERNAME=imgsli
# Required: set a strong value. docker compose fails fast if this is empty.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# TLS terminates at the reverse proxy; secure cookies are allowed on
# localhost (Laravel exempt loopback) so this is safe for the dev server too.
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Album image storage: local (default; storage/app/public + storage:link)
# or s3 (STORAGE_DISK=s3, STORAGE_DISK_ROOT=<bucket>, AWS_* credentials,
# STORAGE_DISK_URL = public base URL).
STORAGE_DISK=local
# STORAGE_DISK_URL=http://localhost:8000/storage

# Discord OAuth (Discord developer application):
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# Production: comma-separated trusted proxy ranges — Cloudflare's published
# IPs (https://www.cloudflare.com/ips/) plus your proxy's subnet (e.g.
# 172.20.0.0/16, the traefik->web hop). Set the full list here in production
# (the .env is the single source of truth — no compose override); leave empty
# locally (no proxy in front of `artisan serve`) so nothing is trusted.
TRUSTED_PROXIES=

# --- Upload & image-fetch limits (config/uploads.php) --------------------
# The values below are the defaults; leave as-is or override to retune. In
# Docker, edit these and run `docker compose up -d` to apply (the entrypoint
# derives the nginx/PHP transport caps from the higher of UPLOAD_MAX_IMAGES /
# UPLOAD_ADMIN_MAX_IMAGES and the higher of UPLOAD_MAX_IMAGE_BYTES /
# UPLOAD_ADMIN_MAX_IMAGE_BYTES so the whole chain resizes together). An empty
# value falls back to the shown default.
UPLOAD_MIN_IMAGES=2
UPLOAD_MAX_IMAGES=8
# Per-album image count for ADMIN users (they bypass the regular count; the
# effective admin limit is the max of the two).
UPLOAD_ADMIN_MAX_IMAGES=16
# Per-image cap in bytes, for file uploads AND server-side URL fetches.
# 10485760 = 10 MB.
UPLOAD_MAX_IMAGE_BYTES=10485760
# Per-image cap in bytes for ADMIN users (they bypass the regular cap; the
# effective admin cap is the max of the two, and the Docker entrypoint sizes
# the transport caps from the higher of the two). 52428800 = 50 MB.
UPLOAD_ADMIN_MAX_IMAGE_BYTES=52428800
# Max length of a pasted image URL string.
UPLOAD_MAX_URL_LENGTH=2048
# Server-side URL fetching: max redirects followed, per-connection timeout
# (seconds), and total seconds all fetches in one request may take.
UPLOAD_MAX_REDIRECTS=3
UPLOAD_HOP_TIMEOUT=30
UPLOAD_STORE_DEADLINE=90
# POST /api/albums rate limit per user: "times,decayMinutes".
UPLOAD_STORE_RATE=10,1
